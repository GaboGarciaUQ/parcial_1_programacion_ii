<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uniquindio.parcial1p2.controlador.ProgramaController">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <top>
        <VBox spacing="5">
            <Label text="Gestión de Programas de Formación"/>
            <Label text="Administración de programas académicos de LinguaPlus"/>
        </VBox>
    </top>

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <content>

                <HBox spacing="25">

                    <VBox spacing="10"
                          HBox.hgrow="ALWAYS">

                        <Label text="Programas registrados"/>

                        <TableView fx:id="tablaProgramas"
                                   VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="columnaCodigo"
                                             text="Código"
                                             prefWidth="90"/>

                                <TableColumn fx:id="columnaNombre"
                                             text="Nombre"
                                             prefWidth="150"/>

                                <TableColumn fx:id="columnaIdioma"
                                             text="Idioma"
                                             prefWidth="100"/>

                                <TableColumn fx:id="columnaDuracionMeses"
                                             text="Duración"
                                             prefWidth="80"/>

                                <TableColumn fx:id="columnaValorMensual"
                                             text="Valor mensual"
                                             prefWidth="110"/>

                                <TableColumn fx:id="columnaEstado"
                                             text="Estado"
                                             prefWidth="100"/>

                                <TableColumn fx:id="columnaModalidad"
                                             text="Modalidad"
                                             prefWidth="100"/>

                                <TableColumn fx:id="columnaTipo"
                                             text="Tipo"
                                             prefWidth="110"/>

                            </columns>

                        </TableView>

                    </VBox>

                    <VBox spacing="12"
                          prefWidth="340">

                        <Label text="Datos del programa"/>

                        <GridPane hgap="10"
                                  vgap="8">

                            <Label text="Código:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="txtCodigo"
                                       promptText="Código"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1"/>

                            <Label text="Nombre:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="2"/>

                            <TextField fx:id="txtNombre"
                                       promptText="Nombre"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="3"/>

                            <Label text="Idioma:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="4"/>

                            <TextField fx:id="txtIdioma"
                                       promptText="Idioma"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="5"/>

                            <Label text="Descripción:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="6"/>

                            <TextField fx:id="txtDescripcion"
                                       promptText="Descripción"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="7"/>

                            <Label text="Duración en meses:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="8"/>

                            <TextField fx:id="txtDuracionMeses"
                                       promptText="Ejemplo: 6"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="9"/>

                            <Label text="Valor mensual:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="10"/>

                            <TextField fx:id="txtValorMensual"
                                       promptText="Ejemplo: 250000"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="11"/>

                            <Label text="Estado:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="12"/>

                            <ComboBox fx:id="cmbEstado"
                                      maxWidth="Infinity"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="13"/>

                            <Label text="Modalidad:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="14"/>

                            <ComboBox fx:id="cmbModalidad"
                                      maxWidth="Infinity"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="15"/>

                            <Label text="Tipo de programa:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="16"/>

                            <ComboBox fx:id="cmbTipoPrograma"
                                      maxWidth="Infinity"
                                      onAction="#cambiarTipoPrograma"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="17"/>

                        </GridPane>

                        <VBox fx:id="panelPersonalizado"
                              spacing="8"
                              managed="false"
                              visible="false">

                            <Label text="Datos del programa personalizado"/>

                            <TextField fx:id="txtCantidadSesiones"
                                       promptText="Cantidad de sesiones"/>

                            <TextField fx:id="txtNivelIdioma"
                                       promptText="Nivel de idioma requerido"/>

                            <TextArea fx:id="txtObjetivos"
                                      promptText="Objetivos del estudiante"
                                      prefRowCount="3"
                                      wrapText="true"/>

                        </VBox>

                        <VBox spacing="8">

                            <Label text="Beneficios"/>

                            <CheckBox fx:id="chkAccesoPlataforma"
                                      text="Acceso a plataforma virtual"/>

                            <CheckBox fx:id="chkClubConversacion"
                                      text="Club de conversación"/>

                            <CheckBox fx:id="chkAcompanamientoTutor"
                                      text="Acompañamiento de tutor"/>

                        </VBox>

                        <HBox spacing="10">

                            <Button text="Agregar"
                                    onAction="#agregarPrograma"/>

                            <Button text="Editar"
                                    onAction="#editarPrograma"/>

                        </HBox>

                        <HBox spacing="10">

                            <Button text="Eliminar"
                                    onAction="#eliminarPrograma"/>

                            <Button text="Limpiar"
                                    onAction="#limpiarCampos"/>

                        </HBox>

                    </VBox>

                </HBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>