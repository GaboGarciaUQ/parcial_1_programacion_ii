<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uniquindio.parcial1p2.controlador.ConsultasController"
      spacing="15">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <!-- TÍTULO -->
    <VBox spacing="5">

        <Label text="Consultas"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Label text="Búsqueda de estudiantes y consulta de ingresos"
               style="-fx-text-fill: #666666;"/>

    </VBox>

    <Separator/>

    <!-- SECCIÓN 1 -->
    <VBox spacing="12">

        <Label text="Buscar estudiante por teléfono"
               style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

        <HBox spacing="10">

            <TextField fx:id="txtTelefonoBuscar"
                       promptText="Ingrese el teléfono"
                       prefWidth="250"/>

            <Button text="Buscar"
                    onAction="#buscarEstudiantePorTelefono"
                    prefWidth="100"/>

        </HBox>

        <!-- RESULTADO ESTUDIANTE -->
<VBox fx:id="panelResultadoEstudiante"
      spacing="7"
      visible="false"
      managed="false"
      style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 12;">

    <Label text="Resultado"
           style="-fx-font-weight: bold;"/>

    <HBox spacing="5">
        <Label text="Nombre completo:"
               style="-fx-font-weight: bold;"/>
        <Label fx:id="lblNombreCompleto"/>
    </HBox>

    <HBox spacing="5">
        <Label text="Documento:"
               style="-fx-font-weight: bold;"/>
        <Label fx:id="lblDocumentoIdentidad"/>
    </HBox>

    <HBox spacing="5">
        <Label text="Correo electrónico:"
               style="-fx-font-weight: bold;"/>
        <Label fx:id="lblCorreoElectronico"/>
    </HBox>

    <HBox spacing="5">
        <Label text="Edad:"
               style="-fx-font-weight: bold;"/>
        <Label fx:id="lblEdad"/>
    </HBox>

</VBox>

        <Label fx:id="lblEsNumeroPerfecto"
               text=""
               style="-fx-font-weight: bold;"/>

    </VBox>

    <Separator/>

    <!-- SECCIÓN 2 -->
    <VBox spacing="12">

        <Label text="Ingresos generados por periodo"
               style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

        <HBox spacing="10">

            <ComboBox fx:id="cmbPeriodo"
                      promptText="Seleccione un periodo"
                      prefWidth="280"/>

            <Button text="Calcular ingresos"
                    onAction="#calcularIngresosPeriodo"
                    prefWidth="150"/>

        </HBox>

        <VBox spacing="5"
              style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 12;">

            <Label text="Ingresos totales"
                   style="-fx-font-weight: bold;"/>

            <Label fx:id="lblIngresosTotal"
                   text="0,00"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        </VBox>

    </VBox>

</VBox>