<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uniquindio.parcial1p2.controlador.DocenteController">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <top>
        <VBox spacing="5">
            <Label text="Gestión de Docentes"/>
            <Label text="Administración de docentes registrados en LinguaPlus"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="25">

            <VBox spacing="10"
                  HBox.hgrow="ALWAYS">

                <Label text="Docentes registrados"/>

                <TableView fx:id="tablaDocentes"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaDocumentoIdentidad"
                                     text="Identificación"
                                     prefWidth="120"/>

                        <TableColumn fx:id="columnaNombreCompleto"
                                     text="Nombre"
                                     prefWidth="160"/>

                        <TableColumn fx:id="columnaEspecialidadIdioma"
                                     text="Idioma / Especialidad"
                                     prefWidth="180"/>

                        <TableColumn fx:id="columnaTelefono"
                                     text="Teléfono"
                                     prefWidth="110"/>

                        <TableColumn fx:id="columnaTarifaSesion"
                                     text="Tarifa por sesión"
                                     prefWidth="130"/>

                    </columns>

                </TableView>

            </VBox>

            <VBox spacing="15"
                  prefWidth="300">

                <Label text="Datos del docente"/>

                <GridPane hgap="10"
                          vgap="10">

                    <Label text="Identificación:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtIdentificacion"
                               promptText="Identificación"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1"/>

                    <Label text="Nombre:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre completo"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3"/>

                    <Label text="Idioma / Especialidad:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <TextField fx:id="txtIdiomaEspecialidad"
                               promptText="Idioma o especialidad"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="5"/>

                    <Label text="Teléfono:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="6"/>

                    <TextField fx:id="txtTelefono"
                               promptText="Teléfono"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="7"/>

                    <Label text="Tarifa por sesión:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="8"/>

                    <TextField fx:id="txtTarifaPorSesion"
                               promptText="Tarifa por sesión"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="9"/>

                </GridPane>

                <HBox spacing="10">

                    <Button text="Agregar"
                            onAction="#agregarDocente"/>

                    <Button text="Editar"
                            onAction="#editarDocente"/>

                </HBox>

                <HBox spacing="10">

                    <Button text="Eliminar"
                            onAction="#eliminarDocente"/>

                    <Button text="Limpiar"
                            onAction="#limpiarCampos"/>

                </HBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>