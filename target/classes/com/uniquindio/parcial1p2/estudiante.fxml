<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uniquindio.parcial1p2.controlador.EstudianteController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <top>
        <VBox spacing="5">
            <Label text="Gestión de Estudiantes"/>
            <Label text="Administración de estudiantes registrados en LinguaPlus"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="25">

            <VBox spacing="10"
                  HBox.hgrow="ALWAYS">

                <Label text="Estudiantes registrados"/>

                <TableView fx:id="tablaEstudiantes"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaNombreCompleto"
                                     text="Nombre completo"
                                     prefWidth="180"/>

                        <TableColumn fx:id="columnaDocumentoIdentidad"
                                     text="Documento"
                                     prefWidth="120"/>

                        <TableColumn fx:id="columnaTelefono"
                                     text="Teléfono"
                                     prefWidth="110"/>

                        <TableColumn fx:id="columnaCorreoElectronico"
                                     text="Correo electrónico"
                                     prefWidth="190"/>

                        <TableColumn fx:id="columnaEdad"
                                     text="Edad"
                                     prefWidth="60"/>

                        <TableColumn fx:id="columnaFechaRegistro"
                                     text="Fecha registro"
                                     prefWidth="120"/>

                    </columns>

                </TableView>

            </VBox>

            <VBox spacing="15"
                  prefWidth="300">

                <Label text="Datos del estudiante"/>

                <GridPane hgap="10"
                          vgap="10">

                    <Label text="Nombre completo:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtNombreCompleto"
                               promptText="Nombre completo"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1"/>

                    <Label text="Documento:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <TextField fx:id="txtDocumento"
                               promptText="Documento de identidad"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3"/>

                    <Label text="Teléfono:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <TextField fx:id="txtTelefono"
                               promptText="Teléfono"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="5"/>

                    <Label text="Correo electrónico:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="6"/>

                    <TextField fx:id="txtCorreo"
                               promptText="correo@dominio.com"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="7"/>

                    <Label text="Edad:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="8"/>

                    <TextField fx:id="txtEdad"
                               promptText="Edad"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="9"/>

                    <Label text="Fecha de registro:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="10"/>

                    <DatePicker fx:id="dpFechaRegistro"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="11"
                                maxWidth="Infinity"/>

                </GridPane>

                <HBox spacing="10">

                    <Button text="Agregar"
                            onAction="#agregarEstudiante"/>

                    <Button text="Editar"
                            onAction="#editarEstudiante"/>

                </HBox>

                <HBox spacing="10">

                    <Button text="Eliminar"
                            onAction="#eliminarEstudiante"/>

                    <Button text="Limpiar"
                            onAction="#limpiarCampos"/>

                </HBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>