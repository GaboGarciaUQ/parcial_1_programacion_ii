<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uniquindio.parcial1p2.controlador.ServicioAdicionalController">

    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <Label text="Servicios Adicionales"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Gestión de servicios adicionales de LinguaPlus"
                   style="-fx-text-fill: #666666;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <!-- TABLA -->
            <VBox spacing="10"
                  HBox.hgrow="ALWAYS">

                <Label text="Servicios registrados"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <TableView fx:id="tablaServicios"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaCodigo"
                                     text="Código"
                                     prefWidth="90"/>

                        <TableColumn fx:id="columnaNombre"
                                     text="Nombre"
                                     prefWidth="130"/>

                        <TableColumn fx:id="columnaDescripcion"
                                     text="Descripción"
                                     prefWidth="190"/>

                        <TableColumn fx:id="columnaPrecio"
                                     text="Precio"
                                     prefWidth="100"/>

                        <TableColumn fx:id="columnaDisponibilidad"
                                     text="Disponible"
                                     prefWidth="100"/>

                        <TableColumn fx:id="columnaTipoServicio"
                                     text="Tipo de Servicio"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

            <!-- FORMULARIO -->
            <VBox spacing="12"
                  prefWidth="300">

                <Label text="Datos del servicio"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <VBox spacing="5">
                    <Label text="Código"/>
                    <TextField fx:id="txtCodigo"
                               promptText="Código del servicio"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Nombre"/>
                    <TextField fx:id="txtNombre"
                               promptText="Nombre del servicio"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Descripción"/>
                    <TextField fx:id="txtDescripcion"
                               promptText="Descripción del servicio"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Precio"/>
                    <TextField fx:id="txtPrecio"
                               promptText="Precio"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Tipo de servicio"/>
                    <ComboBox fx:id="cmbTipoServicio"
                              maxWidth="Infinity"
                              promptText="Seleccione un tipo"/>
                </VBox>

                <CheckBox fx:id="chkDisponibilidad"
                          text="Servicio disponible"/>

                <HBox spacing="8">
                    <Button text="Agregar"
                            onAction="#agregarServicio"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"/>

                    <Button text="Editar"
                            onAction="#editarServicio"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="8">
                    <Button text="Eliminar"
                            onAction="#eliminarServicio"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"/>

                    <Button text="Limpiar"
                            onAction="#limpiarCampos"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"/>
                </HBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>